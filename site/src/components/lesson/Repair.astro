---
/** Fix a broken artifact, reveal the model answer, then self-grade (spec S01 `repair`, `self-grade`). Not reviewed. */
import type { CheckpointPhase } from '@lib/checkpoint-rules';
import CheckpointShell from './CheckpointShell.astro';

interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	/** S02 concept ids the checkpoint exercises, at least one (spec S03 "Checkpoints"). */
	concepts: string[];
	/** One paragraph that makes the item readable outside its lesson; the review page shows it. */
	context?: string;
	broken: string;
	model: string;
	revision?: number;
	/** `first` (default), `review` or `practice` (spec S03 "Checkpoint props"). */
	phase?: CheckpointPhase;
}
const { id, objective, title, hint, concepts, context, broken, model, revision, phase } = Astro.props;
---

<CheckpointShell {id} {objective} {title} {hint} {concepts} {context} {revision} {phase} kind="repair" checkLabel="Enregistrer la note">
	<slot />
	<Fragment slot="body">
		<div class="cp-repair">
			<label>
				<span class="cp-label">Votre version</span>
				<textarea rows={Math.max(4, broken.split('\n').length + 2)} spellcheck="false" set:text={broken}></textarea>
			</label>
			<button type="button" class="cp-reveal-btn">Afficher la réponse modèle</button>
			<div class="cp-model" hidden>
				<span class="cp-label">Réponse modèle</span>
				<pre set:text={model}></pre>
			</div>
			<fieldset class="cp-selfgrade" hidden>
				<legend>Par rapport à la réponse modèle, la vôtre :</legend>
				<label><input type="radio" name={`${id}-selfgrade`} value="pass" /> est aussi bonne, ou couvre les mêmes points</label>
				<label><input type="radio" name={`${id}-selfgrade`} value="partial" /> y est en partie</label>
				<label><input type="radio" name={`${id}-selfgrade`} value="retry" /> demande encore du travail : je la modifie et je réessaie</label>
			</fieldset>
		</div>
	</Fragment>
</CheckpointShell>
