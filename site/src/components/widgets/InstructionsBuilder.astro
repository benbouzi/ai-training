---
// InstructionsBuilder: tick the facts about a project, fill in the short
// fields, and watch the resulting AGENTS.md take shape. Teaches only; it
// never grades. No framework: `scripts/instructions-builder.ts` binds each
// instance, and `scripts/instructions-builder-logic.ts` builds the file.
---

<div class="not-content instructions-builder">
  <form class="ib-form" autocomplete="off">
    <p class="ib-intro">
      Cochez ce qui est vrai pour votre projet et remplissez les champs courts.
      Le fichier de droite se met à jour pendant que vous tapez.
    </p>

    <label class="ib-field">
      <span>Nom du projet</span>
      <input type="text" class="ib-name" placeholder="invoice-mailer" />
    </label>

    <label class="ib-field">
      <span>En une ligne : ce que c’est</span>
      <input type="text" class="ib-purpose" placeholder="Envoie les factures mensuelles en PDF par SMTP." />
    </label>

    <fieldset class="ib-group">
      <legend>Commandes</legend>
      <label class="ib-check">
        <input type="checkbox" class="ib-has-runtime" checked />
        <span>Langage et environnement d’exécution</span>
      </label>
      <input type="text" class="ib-runtime" placeholder="Python 3.13, dépendances avec uv" />

      <label class="ib-check">
        <input type="checkbox" class="ib-has-test" checked />
        <span>Commande de test</span>
      </label>
      <input type="text" class="ib-test" placeholder="uv run pytest" />

      <label class="ib-check">
        <input type="checkbox" class="ib-has-lint" checked />
        <span>Commande de style et de mise en forme</span>
      </label>
      <input type="text" class="ib-lint" placeholder="uv run ruff check . && uv run ruff format ." />
    </fieldset>

    <fieldset class="ib-group">
      <legend>Règles</legend>
      <label class="ib-check">
        <input type="checkbox" class="ib-has-branch" />
        <span>Règle de branche</span>
      </label>
      <input type="text" class="ib-branch" placeholder="Ne jamais committer sur main, créer des branches feat/… ou fix/…" />

      <label class="ib-check">
        <input type="checkbox" class="ib-has-notouch" />
        <span>Fichiers à ne jamais modifier</span>
      </label>
      <input type="text" class="ib-notouch" placeholder="migrations/, uv.lock, tout ce qui est sous vendor/" />

      <label class="ib-check">
        <input type="checkbox" class="ib-has-mistake" />
        <span>Une erreur récurrente à arrêter</span>
      </label>
      <input type="text" class="ib-mistake" placeholder="Ne pas ajouter de nouvelles tentatives autour des appels SMTP : la file d’attente réessaie déjà." />
    </fieldset>
  </form>

  <div class="ib-output">
    <div class="ib-output-head">
      <span class="ib-filename">AGENTS.md</span>
      <span class="ib-count" aria-live="polite"></span>
      <button type="button" class="ib-copy">Copier</button>
    </div>
    <pre class="ib-pre" tabindex="0"><code class="ib-code"></code></pre>
  </div>
</div>

<style>
  .instructions-builder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--at-radius-lg);
    background: var(--at-surface);
    font-size: var(--sl-text-sm);
  }

  @media (max-width: 50rem) {
    .instructions-builder {
      grid-template-columns: 1fr;
    }
  }

  .ib-intro {
    margin: 0 0 0.75rem;
    color: var(--sl-color-gray-2);
  }

  .ib-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ib-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ib-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0.5rem 0.75rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--at-radius-md);
  }

  .ib-group legend {
    padding: 0 0.25rem;
    font-weight: 600;
  }

  .ib-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .ib-check input {
    accent-color: var(--sl-color-accent);
  }

  .instructions-builder input[type='text'] {
    width: 100%;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--at-radius-sm);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
  }

  .instructions-builder input[type='text']:disabled {
    opacity: 0.45;
  }

  .instructions-builder input[type='text']:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .ib-output {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ib-output-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .ib-filename {
    font-family: var(--sl-font-mono);
    font-weight: 600;
  }

  .ib-count {
    flex: 1;
    color: var(--sl-color-gray-3);
  }

  .ib-copy {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: var(--at-radius-pill);
    background: transparent;
    color: var(--sl-color-accent);
    font: inherit;
    cursor: pointer;
  }

  .ib-copy:hover,
  .ib-copy:focus-visible {
    background: var(--sl-color-bg-accent);
    color: var(--sl-color-text-invert);
  }

  .ib-pre {
    flex: 1;
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--at-radius-sm);
    background: var(--sl-color-bg);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { mountInstructionsBuilders } from '@scripts/instructions-builder';

  mountInstructionsBuilders(document);
</script>
