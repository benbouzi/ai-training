---
/** One reference page per topic (spec S02 "Stable URLs"), rendered from the YAML. */
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TopicReference from '@components/TopicReference.astro';
import { areaOf, getAreas } from '@lib/areas';
import { labelOf, MODE_LABEL, SOURCE_TYPE_LABEL } from '@lib/labels-fr';
import { getLessons } from '@lib/lessons';
import { href } from '@lib/url';

export async function getStaticPaths() {
	const topics = await getCollection('topics');
	return topics.map((t) => ({ params: { id: t.data.id }, props: { topic: t.data } }));
}

const { topic } = Astro.props;
const topics = (await getCollection('topics')).map((t) => t.data);
const bibliography = await getCollection('bibliography');
const lessons = (await getLessons()).filter((l) => l.data.covers === topic.id);
const competencies = (await getCollection('competencies'))
	.map((c) => c.data)
	.filter((c) => c.topics.includes(topic.id));
const name = (id: string) => topics.find((t) => t.id === id)?.name ?? id;
const dependants = topics.filter((t) => t.links.prerequisites.includes(topic.id));
const headings = [
	{ depth: 2, slug: 'concepts', text: 'Concepts' },
	{ depth: 2, slug: 'links', text: 'Liens' },
	{ depth: 2, slug: 'lessons', text: 'Leçons' },
	{ depth: 2, slug: 'reference', text: 'Votre référence' },
	{ depth: 2, slug: 'sources', text: 'Sources' },
];
---

<StarlightPage frontmatter={{ title: topic.name, description: topic.definition }} headings={headings}>
	<p><em>{areaOf(await getAreas(), topic.area).name}</em> · thème <code>{topic.id}</code></p>
	<p>{topic.definition}</p>

	<h2 id="concepts">Concepts</h2>
	<dl>
		{topic.concepts.map((c) => (<><dt id={c.id}><strong>{c.name}</strong></dt><dd>{c.definition} <a href={href(`/glossary/#${c.id}`)}>glossaire</a></dd></>))}
	</dl>

	<h2 id="links">Liens</h2>
	<ul>
		<li><strong>S’appuie sur :</strong> {topic.links.prerequisites.length ? topic.links.prerequisites.map((p, i) => (<>{i > 0 && ', '}<a href={href(`/topics/${p}/`)}>{name(p)}</a></>)) : 'rien'}</li>
		<li><strong>Mène à :</strong> {dependants.length ? dependants.map((d, i) => (<>{i > 0 && ', '}<a href={href(`/topics/${d.id}/`)}>{d.name}</a></>)) : 'rien pour l’instant'}</li>
		{topic.links.related.length > 0 && <li><strong>Voir aussi :</strong> {topic.links.related.map((p, i) => (<>{i > 0 && ', '}<a href={href(`/topics/${p}/`)}>{name(p)}</a></>))}</li>}
		{competencies.length > 0 && <li><strong>Compétences qui s’en servent :</strong> {competencies.map((c, i) => (<>{i > 0 && ', '}<a href={href(`/competencies/${c.id}/`)}>{c.statement}</a></>))}</li>}
	</ul>

	<h2 id="lessons">Leçons</h2>
	{lessons.length ? <ul>{lessons.map((l) => <li><a href={href(`/${l.id}/`)}>{l.data.title}</a> ({labelOf(MODE_LABEL, l.data.mode)})</li>)}</ul> : <p>Aucune leçon ne couvre encore ce thème.</p>}

	{/* The learner's reference (spec S02 "Learner's reference"): build-rendered, revealed per finished lesson. */}
	<h2 id="reference">Votre référence</h2>
	<p>Chaque leçon ci-dessus ajoute ici ses points à retenir et son exemple quand vous la terminez. <a href={href('/reference/')}>Votre référence</a> liste toutes les leçons que vous avez terminées.</p>
	<TopicReference topicId={topic.id} />

	<h2 id="sources">Sources</h2>
	{
		topic.sources.length ? (
			<ul>
				{topic.sources.map((key) => {
					const ref = bibliography.find((b) => b.id === key);
					if (!ref) return <li><code>{key}</code> (clé inconnue)</li>;
					const title = ref.data.url ? <a href={ref.data.url}>{ref.data.title}</a> : ref.data.title;
					return <li><code>{key}</code> {title}{ref.data.container && <>, <em>{ref.data.container}</em></>} ({labelOf(SOURCE_TYPE_LABEL, ref.data.type)})</li>;
				})}
			</ul>
		) : (
			<p>Contenu original.</p>
		)
	}
</StarlightPage>
